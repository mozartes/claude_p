# Google Sheets 서비스 계정 이메일
# 예: am-survey-bot@your-project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Google Sheets 서비스 계정 개인키 (JSON 키 파일의 private_key 값 전체)
# 줄바꿈은 \n 문자 그대로 유지한 채 큰따옴표로 감싸서 붙여넣으세요.
# 예: GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=""

# 응답을 저장할 Google Sheets 문서 ID
# 시트 URL 중 https://docs.google.com/spreadsheets/d/【이 부분】/edit
GOOGLE_SHEET_ID=

# /admin 대시보드 접속 비밀번호 (원하는 문자열로 설정)
ADMIN_PASSWORD=
