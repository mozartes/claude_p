# ===== 실행 환경 (예시값) =====
HOST=127.0.0.1
PORT=8000
# 접속 경로 접두어. 예: /public-acr  (없으면 비움)
URL_PREFIX=
# 원본·업로드 저장 위치(영속 저장소 경로로 지정 권장)
DATA_DIR=./data
LOG_DIR=./logs
FLASK_DEBUG=0
MAX_UPLOAD_MB=20
WAITRESS_THREADS=8
# 업로드·적용 권한 토큰(설정 시 업로드 화면에서 입력 필요). 실제 값은 .env 에만 기록
ADMIN_TOKEN=
# 업로드 이력이 없을 때 시작 시 읽을 원본(선택)
DEFAULT_DATA_FILE=
# 기준일 고정(선택, YYYY-MM-DD). 비우면 서버 오늘 날짜
BASE_DATE=
# 대상 본부
TARGET_HQ=공공고객담당
# 기본 조회기간(YYYY-MM). 시작월 비우면 기준일 연도 1월
DEFAULT_YM_FROM=
DEFAULT_YM_TO=2027-12

# ===== 금액 단위 =====
# 원본 금액 단위: 백만원(확인 완료) | 원 | 천원 | 억원 | unknown(원본 단위·확인 필요)
SOURCE_UNIT=백만원

# ===== 업무 기준 (화면에서 조회 시 변경 가능, 금액은 원본 단위=백만원) =====
STALE_DAYS=30
LARGE_CONTRACT_AMOUNT=1000
LARGE_RENEWAL_MONTHLY=30
IMMINENT_MONTHS=1
HIGH_PROBABILITY=70
